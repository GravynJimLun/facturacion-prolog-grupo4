# Copie este archivo como web/.env.local para cambiar la configuración del front end.
# Dirección del backend. Si no se pone, se usa http://localhost:3000
VITE_API_URL=http://localhost:3000
# true = usar los datos de src/datos-de-prueba/ en vez del backend (sirve para
# trabajar en las pantallas sin tener el backend ni Neon encendidos).
VITE_DATOS_DE_PRUEBA=false
