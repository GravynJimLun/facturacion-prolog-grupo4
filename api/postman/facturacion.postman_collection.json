        {
          "name": "Productos y kits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test(\"Trae los 7 productos y los 2 kits\", () => {",
                  "    pm.expect(lista.filter(p => p.tipo === \"producto\")).to.have.lengthOf(7);",
                  "    pm.expect(lista.filter(p => p.tipo === \"kit\")).to.have.lengthOf(2);",
                  "});",
                  "pm.test(\"Cada producto tiene categoría, precio y stock\", () => {",
                  "    lista.filter(p => p.tipo === \"producto\").forEach(p => {",
                  "        pm.expect(p).to.include.keys(\"cod\", \"nombre\", \"categoria\", \"precio\", \"stock\");",
                  "    });",
                  "});",
                  "pm.test(\"El kit k2 incluye al kit k1 (kits recursivos)\", () => {",
                  "    const k2 = lista.find(p => p.cod === \"k2\");",
                  "    pm.expect(k2.componentes).to.include(\"k1\");",
                  "    pm.expect(k2.categoria).to.eql(\"general\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
