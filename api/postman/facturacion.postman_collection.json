              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const f = pm.response.json();",
                  "pm.test(\"Queda pendiente, sin totales\", () => {",
                  "    pm.expect(f.estado).to.eql(\"pendiente\");",
                  "    pm.expect(f.total).to.eql(null);",
                  "});",
                  "pm.test(\"Cabecera Location apunta a la factura\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/facturas/\" + f.id);",
                  "});",
                  "pm.collectionVariables.set(\"idControl\", f.id);"
                ]
              }
            }
          ],
