    {
      "name": "3. Emitir",
      "item": [
        {
          "name": "Emitir: valores de control de la guía",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Queda emitida y sin errores\", () => {",
                  "    pm.expect(r.estado).to.eql(\"emitida\");",
                  "    pm.expect(r.errores).to.be.empty;",
                  "});",
                  "pm.test(\"Subtotal 26 400, IVA 174, total 26 574 (guía §3)\", () => {",
                  "    pm.expect(r.subtotal).to.eql(26400);",
                  "    pm.expect(r.iva).to.eql(174);",
                  "    pm.expect(r.total).to.eql(26574);",
                  "});",
                  "pm.test(\"Arroz con 5 % de descuento por volumen e IVA 1 %\", () => {",
                  "    const arroz = r.lineas.find(l => l.productoCod === \"p1\");",
                  "    pm.expect(arroz.descVolumen).to.eql(5);",
                  "    pm.expect(arroz.tarifaIva).to.eql(1);",
                  "    pm.expect(arroz.base).to.eql(11400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/facturas/{{idControl}}/emitir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "facturas",
                "{{idControl}}",
                "emitir"
              ]
            },
            "description": "Requiere MOTOR=real. Con el motor falso los números no coinciden."
          }
